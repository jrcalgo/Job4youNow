# Job4youNow telegram bot — copy to .env and fill in. Never commit the real file.

# ── Telegram ─────────────────────────────────────────────────────────────────
# A SEPARATE bot from career-ops' own telegram mode — Telegram allows only one
# getUpdates long-poll consumer per token, and career-ops keeps its working
# engine, so this daemon needs its own bot to avoid HTTP 409s. Create one with
# @BotFather, message it once, then run `npm run cli -- whoami` to see chat ids.
TELEGRAM_BOT_TOKEN=
# A private chat's chat.id is your own Telegram user id — the SAME value works
# for both this bot and career-ops' bot, only the token differs.
TELEGRAM_CHAT_ID=

# ── Aurora PostgreSQL Serverless v2 (Data API) ───────────────────────────────
# See infra/aurora-setup.md for how to provision these.
AWS_REGION=
AURORA_RESOURCE_ARN=
AURORA_SECRET_ARN=
AURORA_DATABASE=job4younow

# ── S3 (durable artifact origin) ─────────────────────────────────────────────
S3_BUCKET=
S3_PREFIX=job4younow-telegram/

# ── AWS credentials ───────────────────────────────────────────────────────────
# Leave all three blank if you're using AWS_PROFILE (with ~/.aws mounted read-only
# by docker-compose.yml) instead of static keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# ── Local artifact cache ─────────────────────────────────────────────────────
J4N_CACHE_DIR=/app/.cache
# LRU-evicted once the cache exceeds this many bytes. Default: 512 MiB.
J4N_CACHE_MAX_BYTES=536870912

# ── Daemon tuning ─────────────────────────────────────────────────────────────
# Long-poll timeout per getUpdates call, in seconds (Telegram caps this at 50).
J4N_POLL_TIMEOUT_SEC=50
# Fallback interval for noticing newly-ingested queues without a QUEUES command,
# in ms. 0 disables the fallback (rely on the QUEUES command only). Deliberately
# long by default — this touches Aurora, and doing it too often defeats
# auto-pause (see infra/aurora-setup.md).
J4N_QUEUE_REFRESH_MS=900000
# Session lease TTL / renewal cadence, in ms — guards against two daemon
# instances (e.g. a brief overlap during a redeploy) polling the same session.
J4N_LEASE_TTL_MS=180000
J4N_LEASE_RENEW_MS=60000
# Liveness file touched after every poll cycle; see docker-compose.yml healthcheck.
J4N_HEARTBEAT_FILE=/app/.cache/.heartbeat

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error
J4N_LOG_LEVEL=info
