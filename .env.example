# Job4youNow — copy to .env at the REPO ROOT and fill in. Never commit the
# real file. There is deliberately only ONE .env.example in this repo (not
# one per service) — agent/docker-compose.yml and telegram/docker-compose.yml
# both read this same file via `env_file: ../.env`, so every setting either
# service needs is documented once, in one place, organized by boundary
# rather than by service.
#
# Privacy boundary (see agent/app/models/artifacts.py for the vocabulary):
# private user data (resumes, anything derived from them) NEVER touches
# Aurora and NEVER touches the job-artifacts bucket — only the dedicated
# private-user bucket below, plus a local backup near career-ops-modified.

# ── Cursor SDK (agent app) ───────────────────────────────────────────────────
# Required even when the local `cursor-agent` CLI is already logged in —
# local runtime does not reuse CLI session auth, it always needs an explicit
# key. Get one from https://cursor.com/dashboard/integrations.
CURSOR_API_KEY=
# Default model for every task kind with no per-(chat, task kind) override
# saved via the Telegram MODELS menu (see agent/app/config.py's
# DEFAULT_MODEL_ID and agent/app/routing/model_config.py).
CURSOR_MODEL=grok-4.5

# ── Aurora PostgreSQL Serverless v2 (Data API) ───────────────────────────────
# Metadata + public job-search data ONLY — see infra/aurora-setup.md for how
# to provision these. The agent app is the only service with these
# credentials; the telegram adapter holds no Aurora access at all.
AWS_REGION=
AURORA_RESOURCE_ARN=
AURORA_SECRET_ARN=
AURORA_DATABASE=job4younow

# ── S3: public/job-search artifacts ─────────────────────────────────────────
# Job-queue artifacts (CVs/JDs for review) and any future public scan
# reports. Never write private user content here.
JOB_ARTIFACTS_BUCKET=
JOB_ARTIFACTS_PREFIX=job4younow-telegram/

# ── S3: private user artifacts ──────────────────────────────────────────────
# A SEPARATE bucket, its own IAM policy — augmented resumes, private text
# responses, private reports. See infra/private-artifacts-setup.md.
PRIVATE_USER_ARTIFACTS_BUCKET=
PRIVATE_USER_ARTIFACTS_PREFIX=private/

# ── Local private user-data (agent app; paths inside its container) ────────
# Resume templates are read from here; augmented resumes are written here
# AND to the private bucket above, in the same call — see
# agent/app/tools/artifact_store.py's PrivateStores.
CAREER_OPS_DIR=/repo/agent/modules/career-ops-modified
PRIVATE_LOCAL_BACKUP_DIR=/repo/agent/modules/career-ops-modified/resumes/augmented

# ── Agent app: HTTP API ───────────────────────────────────────────────────────
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8000
# The telegram adapter's only way to reach the agent app — same Docker
# network, so the service name resolves; change if you split hosts.
AGENT_API_BASE=http://agent:8000

# ── Agent app: concurrency limits ────────────────────────────────────────────
# User-requested tasks get their own pool so a scheduled scan can never make
# a live Telegram request wait behind it.
AGENT_MAX_USER_TASKS=2
AGENT_MAX_SCAN_TASKS=1
AGENT_MAX_CURSOR_RUNS=2

# ── Agent app: task leasing / polling cadence (seconds) ──────────────────────
AGENT_TASK_LEASE_SECONDS=600
AGENT_WORKER_POLL_SECONDS=2
AGENT_SCHEDULER_POLL_SECONDS=30

# ── Agent app: read-through cache (deterministic DB reads only) ─────────────
AGENT_CACHE_TTL_SECONDS=60
AGENT_CACHE_MAX_ENTRIES=512

# ── Agent app: Cursor SDK run timeout (seconds) ──────────────────────────────
AGENT_CURSOR_TIMEOUT_SECONDS=180

# ── Agent app: career-ops run timeouts (seconds) ─────────────────────────────
# scan/pdf run career-ops's real, multi-step pipelines (see
# agent/infra/career-ops-setup.md) — much longer than a plain prompt.
AGENT_SCAN_TIMEOUT_SECONDS=600
AGENT_SCAN_SUBPROCESS_TIMEOUT_SECONDS=300
AGENT_RESUME_TIMEOUT_SECONDS=600

# ── Agent app: logging ────────────────────────────────────────────────────────
# debug | info | warning | error
AGENT_LOG_LEVEL=info

# ── Telegram adapter ──────────────────────────────────────────────────────────
# Telegram allows only one getUpdates long-poll consumer per token. Create
# one with @BotFather, message it once, then run `npm run cli -- whoami`
# (from telegram/) to see chat ids.
TELEGRAM_BOT_TOKEN=
# A private chat's chat.id is your own Telegram user id.
TELEGRAM_CHAT_ID=

# Local artifact cache (LRU-evicted by the bot itself; separate
# subdirectories per bucket kind — see artifacts/store.mjs).
J4N_CACHE_DIR=/app/.cache
J4N_CACHE_MAX_BYTES=536870912

# Long-poll timeout per getUpdates call, in seconds (Telegram caps this at 50).
J4N_POLL_TIMEOUT_SEC=50
# Fallback interval for noticing newly-ingested queues without a QUEUES
# command, in ms. 0 disables the fallback. Deliberately long by default —
# this touches Aurora, and doing it too often defeats auto-pause.
J4N_QUEUE_REFRESH_MS=900000
# Session lease TTL / renewal cadence, in ms.
J4N_LEASE_TTL_MS=180000
J4N_LEASE_RENEW_MS=60000
# Liveness file touched after every poll cycle; see docker-compose.yml healthcheck.
J4N_HEARTBEAT_FILE=/app/.cache/.heartbeat

# Agent-app outbox delivery loop — delivers predictive-task results (SCAN,
# resume tailoring, and any free-text question that doesn't resolve
# synchronously) once the agent app finishes background work. ON by default:
# bot.mjs now forwards free text to the agent app (see agent/inbound.mjs),
# and its immediate-reply path alone only covers deterministic, synchronous
# responses — without this loop a predictive task's result would never
# reach Telegram. Set to 0 only when running this adapter with NO agent app
# at all (pure queue-review mode).
J4N_AGENT_OUTBOX_ENABLED=1
J4N_AGENT_OUTBOX_POLL_MS=3000

# debug | info | warn | error
J4N_LOG_LEVEL=info

# ── AWS credentials (shared by both services) ────────────────────────────────
# Leave all three blank if you're using AWS_PROFILE (with ~/.aws mounted
# read-only by docker-compose.yml) instead of static keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
